# Пример конфигурации для локального запуска ml-inference вне Docker.
# Скопируйте в .env и заполните при необходимости.

LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=localhost:29092

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cxr_minio
S3_SECRET_KEY=cxr_minio_pass
S3_BUCKET=cxr-images

MODEL_PATH=./models/best.pt